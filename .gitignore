# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║ Project Bootstrap - .gitignore                                            ║
# ╠═══════════════════════════════════════════════════════════════════════════╣
# ║ Project initialization and scaffolding utility                            ║
# ║ Stack: Shell scripts, templates                                          ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# ─── Environment & Secrets ───────────────────────────────────────────────────
.env
.env.*

# ─── Testing ─────────────────────────────────────────────────────────────────
test-*/
*.test
test_projects/
bootstrap_test_*/

# ─── Temporary Files ─────────────────────────────────────────────────────────
/tmp/
*.tmp
*.temp
*~

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
bootstrap_*.log

# ─── Generated Projects ──────────────────────────────────────────────────────
# Projects created during testing
generated/
output/
bootstrapped_*/

# ─── IDE & Editors ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-*
*.swp
*.swo
